# RPC URL is intentionally configuration, not code. Arc testnet example:
ARC_RPC_URL=https://rpc.testnet.arc.io
PRIVATE_KEY=
USDC_ADDRESS=
TREASURY_ADDRESS=
# Owner-managed account allowed to create markets; set to keeper, never grant it owner.
MARKET_CREATOR=
# Optional; defaults to the broadcast account.
FACTORY_OWNER=
FACTORY_ADDRESS=
VAULT_ADDRESS=
VAULT_OWNER=
OPERATOR_ADDRESS=

# Keeper and API — use a distinct, funded operator/keeper wallet.
KEEPER_PRIVATE_KEY=
ARC_CHAIN_ID=5042002
KEEPER_POLL_MS=15000
JWT_SECRET=
WALLET_MASTER_SECRET=
GOOGLE_CLIENT_ID=
API_PORT=3000
USERS_DB_PATH=data/users.json

# TESTNET ONLY — populated after `DeployTestnetMocks.s.sol`.
TESTNET_MOCK_BTC_USD_FEED=
TESTNET_MOCK_ETH_USD_FEED=
MOCK_ORACLE_OWNER=

# Verified Arc mainnet Chainlink proxy feeds (for use when setting market inputs):
# BTC/USD: 0xa109B535C70C8Be9995be64Bb6751AcDB27e03De
# ETH/USD: 0x50FCDD99D6762D1C170DC6A9111db944AEE6D364
